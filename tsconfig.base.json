{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@emergentinc/protocol": ["packages/protocol/src"],
      "@emergentinc/protocol/*": ["packages/protocol/src/*"],
      "@emergentinc/domain": ["packages/domain/src"],
      "@emergentinc/domain/*": ["packages/domain/src/*"],
      "@emergentinc/persistence": ["packages/persistence/src"],
      "@emergentinc/persistence/*": ["packages/persistence/src/*"],
      "@emergentinc/model": ["packages/model/src"],
      "@emergentinc/model/*": ["packages/model/src/*"],
      "@emergentinc/tools": ["packages/tools/src"],
      "@emergentinc/tools/*": ["packages/tools/src/*"],
      "@emergentinc/runtime": ["packages/runtime/src"],
      "@emergentinc/runtime/*": ["packages/runtime/src/*"]
    }
  }
}
