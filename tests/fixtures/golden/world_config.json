{
  "version": "5.0.0",
  "runtime": {
    "mode": "api_sandbox",
    "allow_agent_runtime": false
  },
  "experiment_seed": 20260915,
  "model": {
    "provider": "openai_compatible",
    "env_file": ".env",
    "base_url": "CONFIGURE_ME",
    "base_url_env": "MCL_BASE_URL",
    "api_key_env": "MCL_API_KEY",
    "default_model": "CONFIGURE_ME",
    "decision_model_env": "MCL_DECISION_MODEL",
    "validator_model_env": "MCL_VALIDATOR_MODEL",
    "memory_model_env": "MCL_MEMORY_MODEL",
    "fallback_model_env": "MCL_MODEL",
    "temperature": {
      "decision": 0.65,
      "validator": 0.15,
      "memory": 0.25
    },
    "max_output_tokens": {
      "decision": 1600,
      "validator": 1000,
      "memory": 900
    },
    "response_format": "json_object"
  },
  "sandbox": {
    "max_string_chars": 5000,
    "max_evidence_items_per_problem": 8,
    "forbidden_key_fragments": [
      "world_state",
      "all_pixels",
      "global_resource",
      "owner_private",
      "api_key",
      "secret",
      "password",
      "private_key",
      "future_schedule",
      "experiment_schedule",
      "repository_path",
      "git_token"
    ],
    "external_content_label": "UNTRUSTED_EXTERNAL_DATA"
  },
  "resource": {
    "initial_pixel_resource": 100.0,
    "maintenance_cost_per_round": 0.25,
    "work_cost": 1.0,
    "create_problem_cost": 1.0,
    "offer_cost": 0.5,
    "bid_cost": 0.5,
    "accept_bid_cost": 0.2,
    "accept_cost": 0.0,
    "reject_cost": 0.0,
    "transfer_cost": 0.5,
    "spawn_cost": 8.0,
    "default_birth_grant": 12.0,
    "request_close_cost": 0.2,
    "abandon_cost": 0.2,
    "request_capability_cost": 0.2,
    "use_capability_cost": 0.5,
    "wait_external_cost": 0.0,
    "invalid_action_cost": 0.2,
    "grace_rounds": 3
  },
  "external": {
    "owner_required": true,
    "capability_profiles_dir": "owner_private/capabilities",
    "ssh_timeout_seconds": 60,
    "tool_output_max_chars": 8000,
    "wait_external_default_rounds": 3,
    "wait_external_max_rounds": 20
  },
  "logging": {
    "write_local_view_to_inbox": true,
    "record_token_usage": true,
    "record_prompt_hash": true,
    "record_sandbox_hash": true,
    "record_sandbox_keys": true
  }
}
