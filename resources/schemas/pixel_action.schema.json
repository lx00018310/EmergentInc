{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PixelDecisionV8",
  "type": "object",
  "required": [
    "pixel",
    "round",
    "action"
  ],
  "properties": {
    "pixel": {
      "type": "string"
    },
    "round": {
      "type": "integer",
      "minimum": 1
    },
    "perception_summary": {
      "type": "string"
    },
    "intent": {
      "type": "string"
    },
    "reasoning_summary": {
      "type": "string"
    },
    "action": {
      "enum": [
        "WORK",
        "MESSAGE",
        "ASK_OWNER",
        "REPRODUCE",
        "WAIT",
        "IDLE"
      ]
    },
    "work": {
      "type": ["object", "null"],
      "properties": {
        "intent": {"type": "string"},
        "operations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["tool"],
            "properties": {
              "tool": {"type": "string"},
              "args": {"type": "object"}
            }
          },
          "maxItems": 3
        }
      }
    },
    "message": {
      "type": ["object", "null"],
      "required": ["to", "content"],
      "properties": {
        "to": {"type": "string"},
        "content": {"type": "string"},
        "energy": {"type": "number", "minimum": 0},
        "attachments": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "owner_request": {
      "type": ["object", "null"],
      "properties": {
        "needed_resource": {"type": "string"},
        "question": {"type": "string"},
        "purpose": {"type": "string"}
      }
    },
    "reproduce": {
      "type": ["object", "null"],
      "required": ["target", "energy_to_child"],
      "properties": {
        "target": {
          "type": "array",
          "items": {"type": "integer"},
          "minItems": 3,
          "maxItems": 3
        },
        "energy_to_child": {"type": "number", "minimum": 1},
        "inheritance": {"type": "string"}
      }
    },
    "wait": {
      "type": ["object", "null"],
      "properties": {
        "reason": {"type": "string"},
        "wake_after": {"type": "integer", "minimum": 1}
      }
    },
    "problem_id": {
      "type": ["string", "null"]
    },
    "work_output": {
      "type": ["object", "null"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "details": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1
        }
      },
      "required": ["summary", "details"],
      "additionalProperties": false
    }
  }
}
