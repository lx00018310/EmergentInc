{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "status",
    "type",
    "granted_to",
    "request_id",
    "allowed_operations",
    "created_round"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "ACTIVE",
        "REVOKED",
        "EXPIRED"
      ]
    },
    "type": {
      "type": "string"
    },
    "granted_to": {
      "type": "string"
    },
    "problem_scope": {
      "type": [
        "string",
        "null"
      ]
    },
    "request_id": {
      "type": "string"
    },
    "allowed_operations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "public_metadata": {
      "type": "object"
    },
    "created_round": {
      "type": "integer"
    },
    "expires_round": {
      "type": [
        "integer",
        "null"
      ]
    }
  }
}
