{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "verdict",
    "matched_acceptance",
    "missing_acceptance",
    "reason"
  ],
  "properties": {
    "verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "INSUFFICIENT"
      ]
    },
    "matched_acceptance": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "missing_acceptance": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reason": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
