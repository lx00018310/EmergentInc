{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "V9PixelResponse",
  "type": "object",
  "required": [
    "pixel_md",
    "message_md",
    "send_to",
    "environment_read",
    "reproduce",
    "energy_transfer",
    "owner_request",
    "operations"
  ],
  "properties": {
    "pixel_md": {
      "type": "string",
      "description": "更新后的完整自身心智历史 (<=2000字)"
    },
    "message_md": {
      "type": "string",
      "description": "准备继续传递的消息内容 (<=2000字)"
    },
    "send_to": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "路由目标: SELF / STOP / 活跃直接邻居ID列表"
    },
    "environment_read": {
      "type": "boolean",
      "description": "是否在下一跳主动读取外部环境 environment.md"
    },
    "reproduce": {
      "type": ["object", "null"],
      "properties": {
        "target": {
          "type": "array",
          "items": { "type": "integer" },
          "minItems": 3,
          "maxItems": 3
        },
        "child_energy": {
          "type": "integer",
          "minimum": 1
        },
        "child_pixel_md": {
          "type": "string"
        }
      },
      "required": ["target", "child_energy", "child_pixel_md"]
    },
    "energy_transfer": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["to", "amount"],
        "properties": {
          "to": { "type": "string" },
          "amount": { "type": "integer", "minimum": 1 },
          "ref_message_id": { "type": ["string", "null"] }
        }
      }
    },
    "owner_request": {
      "type": ["object", "null"],
      "properties": {
        "type": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["type", "description"]
    },
    "operations": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["tool", "args"],
        "properties": {
          "tool": { "type": "string" },
          "args": { "type": "object" }
        }
      }
    }
  },
  "additionalProperties": false
}
