{
  "version": "4.0.0",
  "experiment_seed": 20260914,
  "runtime": {
    "mode": "agent_queue",
    "agent_queue": {
      "requests_dir": "runtime/agent_requests",
      "responses_dir": "runtime/agent_responses",
      "pending_round_file": "runtime/pending_round.json"
    }
  },
  "model": {
    "provider": "openai_compatible",
    "model": "CONFIGURE_ME",
    "base_url": "CONFIGURE_ME",
    "api_key_env": "MCL_API_KEY",
    "temperature": 0.65,
    "max_output_tokens": 1400
  },
  "space": {
    "neighborhood": "von_neumann_6"
  },
  "resource": {
    "initial_pixel_resource": 100.0,
    "maintenance_cost_per_round": 0.25,
    "work_cost": 1.0,
    "create_problem_cost": 1.0,
    "offer_cost": 0.5,
    "bid_cost": 0.5,
    "accept_bid_cost": 0.2,
    "accept_cost": 0.0,
    "reject_cost": 0.0,
    "transfer_cost": 0.5,
    "spawn_cost": 8.0,
    "default_birth_grant": 12.0,
    "request_close_cost": 0.2,
    "abandon_cost": 0.2,
    "request_capability_cost": 0.2,
    "use_capability_cost": 0.5,
    "wait_external_cost": 0.0,
    "invalid_action_cost": 0.2,
    "grace_rounds": 3
  },
  "external": {
    "owner_required": true,
    "capability_profiles_dir": "owner_private/capabilities",
    "ssh_timeout_seconds": 60,
    "tool_output_max_chars": 8000
  },
  "llm": {
    "skip_when_idle": true,
    "memory_update_on": [
      "CLOSED",
      "FAILED_CLOSE",
      "SPAWN",
      "CAPABILITY_GRANTED",
      "CAPABILITY_REJECTED",
      "TOOL_RESULT",
      "REAL_PAYMENT"
    ]
  },
  "logging": {
    "write_local_view_to_inbox": true,
    "record_token_usage": true,
    "record_prompt_hash": true
  }
}
