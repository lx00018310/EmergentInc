HOST=127.0.0.1
PORT=8765
EMERGENTINC_OWNER_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
EMERGENTINC_SECURE_COOKIES=1
EMERGENTINC_TRUST_LOOPBACK_PROXY=1
# A reverse proxy must terminate HTTPS. Keep the application on loopback.
MCL_BASE_URL=https://YOUR_MODEL_PROVIDER/v1
MCL_API_KEY=REPLACE_WITH_PROVIDER_KEY
MCL_DECISION_MODEL=YOUR_EXACT_MODEL_ID
EMERGENTINC_DREAM_TIME=03:00
EMERGENTINC_ACTIVE_GENERATION_FILE=/srv/emergentinc/active-generation.json
EMERGENTINC_DREAM_TIMEZONE=Asia/Shanghai
EMERGENTINC_BODY_SANDBOX_SOCKET=/run/emergentinc-body/body.sock
