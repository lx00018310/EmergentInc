{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "pixel",
    "round",
    "action",
    "reasoning_summary"
  ],
  "properties": {
    "pixel": {
      "type": "string"
    },
    "round": {
      "type": "integer",
      "minimum": 1
    },
    "action": {
      "enum": [
        "WORK",
        "CREATE_PROBLEM",
        "OFFER",
        "BID",
        "ACCEPT_BID",
        "ACCEPT",
        "REJECT",
        "TRANSFER",
        "SPAWN",
        "REQUEST_CLOSE",
        "ABANDON",
        "IDLE"
      ]
    },
    "problem_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "target_pixel": {
      "type": [
        "string",
        "null"
      ]
    },
    "offered_resource": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "requested_resource": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "work_output": {
      "type": [
        "object",
        "null"
      ]
    },
    "new_problem": {
      "type": [
        "object",
        "null"
      ]
    },
    "spawn_proposal": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "target_pixel": {
          "type": "string"
        },
        "mutation": {
          "type": "object"
        }
      },
      "required": [
        "target_pixel",
        "mutation"
      ],
      "additionalProperties": false
    },
    "reasoning_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 900
    }
  },
  "additionalProperties": false
}
