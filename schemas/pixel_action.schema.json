{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PixelActionV4",
  "type": "object",
  "required": [
    "pixel",
    "round",
    "action",
    "reasoning_summary"
  ],
  "properties": {
    "pixel": {
      "type": "string"
    },
    "round": {
      "type": "integer",
      "minimum": 1
    },
    "action": {
      "enum": [
        "WORK",
        "CREATE_PROBLEM",
        "OFFER",
        "BID",
        "ACCEPT_BID",
        "ACCEPT",
        "REJECT",
        "TRANSFER",
        "SPAWN",
        "REQUEST_CLOSE",
        "ABANDON",
        "IDLE",
        "REQUEST_CAPABILITY",
        "USE_CAPABILITY",
        "WAIT_EXTERNAL"
      ]
    },
    "problem_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "target_pixel": {
      "type": [
        "string",
        "null"
      ]
    },
    "offered_resource": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "requested_resource": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "work_output": {
      "type": [
        "object",
        "null"
      ]
    },
    "new_problem": {
      "type": [
        "object",
        "null"
      ]
    },
    "spawn_proposal": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "target_pixel": {
          "type": "string"
        },
        "mutation": {
          "type": "object"
        }
      },
      "required": [
        "target_pixel",
        "mutation"
      ],
      "additionalProperties": false
    },
    "capability_request": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "capability_type": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "minimum_requirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requested_operations": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "estimated_external_cost": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "amount": {
              "type": "number",
              "minimum": 0
            },
            "currency": {
              "type": "string"
            },
            "recurring": {
              "type": "boolean"
            }
          },
          "required": [
            "amount",
            "currency"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "capability_type",
        "purpose",
        "minimum_requirements",
        "requested_operations"
      ],
      "additionalProperties": false
    },
    "capability_use": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "capability_id": {
          "type": "string"
        },
        "operation": {
          "type": "string"
        },
        "arguments": {
          "type": "object"
        }
      },
      "required": [
        "capability_id",
        "operation",
        "arguments"
      ],
      "additionalProperties": false
    },
    "wait_external": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "reason": {
          "type": "string"
        },
        "waiting_for": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "reason",
        "waiting_for"
      ],
      "additionalProperties": false
    },
    "reasoning_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    }
  },
  "additionalProperties": false
}
