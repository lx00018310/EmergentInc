{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "status",
    "requester",
    "problem_id",
    "capability_type",
    "purpose",
    "minimum_requirements",
    "requested_operations",
    "created_round"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "PENDING_OWNER",
        "APPROVED",
        "REJECTED",
        "REVOKED"
      ]
    },
    "requester": {
      "type": "string"
    },
    "problem_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "capability_type": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "minimum_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requested_operations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "estimated_external_cost": {
      "type": [
        "object",
        "null"
      ]
    },
    "created_round": {
      "type": "integer"
    },
    "resolved_round": {
      "type": [
        "integer",
        "null"
      ]
    },
    "owner_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "capability_id": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
