{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "direction",
    "amount",
    "currency",
    "problem_id",
    "source",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "direction": {
      "enum": [
        "INFLOW",
        "OUTFLOW"
      ]
    },
    "amount": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "currency": {
      "type": "string"
    },
    "problem_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "receipt_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string"
    }
  }
}
