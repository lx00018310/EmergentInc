# 大模型 API 配置（OpenAI 兼容格式）
# 复制本文件为 .env 并填写实际的 API Key、Base URL 与 Model

# 本机业务入口。Owner 登录口令必须使用至少32字符的随机值。
EMERGENTINC_RUNTIME_MODE=business
EMERGENTINC_OWNER_SECRET=
HOST=127.0.0.1
EMERGENTINC_SECURE_COOKIES=0
# V34 老板入口 / Owner page: http://127.0.0.1:8765/BOSS
# 受控软件发布 / Controlled software publication: http://127.0.0.1:8766
# 上述 Cookie 设置只适用于本机 HTTP；对外访问须使用 HTTPS 和 SECURE_COOKIES=1。

# 基础配置
MCL_API_KEY=
MCL_BASE_URL=https://api.openai.com/v1
MCL_MODEL=gpt-4o-mini
NO_PROXY=127.0.0.1,localhost

# 可选：细分场景模型覆盖配置（若不设置则默认使用 MCL_MODEL）
# MCL_DECISION_MODEL=gpt-4o

# 可选：输出预算上限。推理模型的思考 token 占用整个 completion 预算，
# 未设置时代码对 glm 模型兜底为 16384，思考偏长的轮次会被截断成空 content。
# MCL_MAX_TOKENS=32768

# 可选：上游支持 SSE 时启用，避免长推理在首个响应前被中间连接断开。
# 流中断仍记为结果未知；缺少最终 usage 不会补造用量或自动重试。
# MCL_STREAM=1
